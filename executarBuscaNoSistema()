async function executarBuscaNoSistema() {
    const placaInput = document.getElementById("placa").value.trim().toUpperCase();
    const modeloInput = document.getElementById("modelo-input").value.trim().toUpperCase();
    const categoriaSelect = document.getElementById("categoria").value;
    const loadingDiv = document.getElementById("loading");
    const resultadoDiv = document.getElementById("resultado");

    if (!categoriaSelect) {
        alert("Por favor, selecione uma categoria de peças.");
        return;
    }

    // Limpa a tela e exibe o estado de "Carregando"
    loadingDiv.style.display = "block";
    resultadoDiv.style.display = "none";
    resultadoDiv.innerHTML = "";

    let dadosVeiculo = null;

    try {
        // 1. CRITÉRIO DE BUSCA: Se houver placa digitada, consome a API Real
        if (placaInput) {
            // Configurações da API (Substitua pelos dados da sua credencial contratada)
            const API_URL = `https://gateway-veiculos.com.br{placaInput}`; 
            const API_TOKEN = "SEU_TOKEN_AQUI"; 

            const resposta = await fetch(API_URL, {
                method: "GET",
                headers: {
                    "Authorization": `Bearer ${API_TOKEN}`,
                    "Content-Type": "application/json"
                }
            });

            if (!resposta.ok) {
                throw new Error("Erro ao consultar a placa informada.");
            }

            const dadosApi = await resposta.json();
            
            // Mapeia o retorno da API para a estrutura aceita pelo seu catálogo
            dadosVeiculo = {
                marca: dadosApi.marca || "Não Informado",
                modelo: dadosApi.modelo || "Não Informado",
                ano: dadosApi.anoModelo || dadosApi.ano || "Não Informado",
                // Tenta mapear o modelo retornado pela API para as suas peças estáticas
                chavePecas: identificarChavePecas(dadosApi.modelo) 
            };

        } else if (modeloInput) {
            // 2. CRITÉRIO DE BUSCA: Se for por texto do modelo, usa a tabela estática antiga
            let chave = "PADRAO";
            if (modeloInput.includes("UNO")) chave = "UNO";
            else if (modeloInput.includes("CIVIC")) chave = "CIVIC";

            const local = catalogoPecasTecnicas[chave];
            dadosVeiculo = {
                marca: local.marca,
                modelo: local.modelo,
                ano: local.ano || local.versao,
                chavePecas: chave
            };
        } else {
            alert("Digite uma Placa ou um Modelo para realizar a busca.");
            loadingDiv.style.display = "none";
            return;
        }

        // 3. EXIBIÇÃO DOS RESULTADOS NA TELA
        loadingDiv.style.display = "none";
        resultadoDiv.style.display = "block";

        let htmlConteudo = `
            <div class="vehicle-info">
                <strong>Marca:</strong> ${dadosVeiculo.marca} <br>
                <strong>Modelo:</strong> ${dadosVeiculo.modelo} <br>
                <strong>Ano:</strong> ${dadosVeiculo.ano}
            </div>
            <div class="category-title">Categoria Selecionada: ${categoriaSelect.toUpperCase()}</div>
        `;

        // Recupera o catálogo de peças correspondente (UNO, CIVIC ou PADRAO)
        const pecasDoModelo = catalogoPecasTecnicas[dadosVeiculo.chavePecas];

        if (categoriaSelect === "oleo_filtros" && pecasDoModelo.oleo_filtros) {
            const oleo = pecasDoModelo.oleo_filtros;
            htmlConteudo += `
                <p><strong>Viscosidade:</strong> ${oleo.viscosidade}</p>
                <p><strong>Quantidade:</strong> ${oleo.quantidade}</p>
                <table>
                    <thead><tr><th>Filtro</th><th>Marca</th><th>Código</th></tr></thead>
                    <tbody>
            `;
            oleo.filtros.forEach(f => {
                htmlConteudo += `<tr><td>${f.nome}</td><td>${f.marca}</td><td>${f.codigo}</td></tr>`;
            });
            htmlConteudo += `</tbody></table>`;
        } else if (pecasDoModelo[categoriaSelect] && pecasDoModelo[categoriaSelect].pecas) {
            htmlConteudo += `
                <table>
                    <thead><tr><th>Peça / Item</th><th>Marca</th><th>Código</th></tr></thead>
                    <tbody>
            `;
            pecasDoModelo[categoriaSelect].pecas.forEach(p => {
                htmlConteudo += `<tr><td>${p.item}</td><td>${p.marca}</td><td>${p.codigo}</td></tr>`;
            });
            htmlConteudo += `</tbody></table>`;
        } else {
            htmlConteudo += `<p>Nenhum detalhe técnico mapeado para este veículo.</p>`;
        }

        resultadoDiv.innerHTML = htmlConteudo;

    } catch (erro) {
        loadingDiv.style.display = "none";
        alert("Erro na requisição: " + erro.message);
    }
}

// Função auxiliar para analisar o texto retornado da API e cruzar com o seu catálogo técnico
function identificarChavePecas(modeloTexto) {
    if (!modeloTexto) return "PADRAO";
    const texto = modeloTexto.toUpperCase();
    if (texto.includes("UNO")) return "UNO";
    if (texto.includes("CIVIC")) return "CIVIC";
    return "PADRAO";
}
